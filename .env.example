# Скопируйте в .env и заполните. Файл .env не коммитится и не пересылается в чат.

# Аккаунт-сборщик: api_id и api_hash с my.telegram.org (зайти с ОТДЕЛЬНОГО аккаунта)
TG_API_ID=
TG_API_HASH=
# Имя файла сессии в папке data/ (создаётся командой login)
TG_SESSION=collector

# База. Для локальной разработки подходит значение ниже (база из docker compose).
DATABASE_URL=postgresql://gigo:gigo@localhost:5432/gigo

# Сколько дней истории подтягивать из каждого чата при первом проходе
BACKFILL_DAYS=7
# Пауза между вступлениями в чаты, секунды (вступаем постепенно, чтобы не словить бан)
JOIN_DELAY_MIN=120
JOIN_DELAY_MAX=300
# Сколько чатов можно вступить за один запуск join
JOIN_BATCH=5
