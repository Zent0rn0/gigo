# Скопируйте в .env и заполните. Файл .env не коммитится и не пересылается в чат.

# База. Для локальной разработки подходит значение ниже (база из docker compose).
# На сервере задайте свой длинный POSTGRES_PASSWORD (и поменяйте его же в DATABASE_URL).
POSTGRES_PASSWORD=gigo
DATABASE_URL=postgresql://gigo:gigo@localhost:5432/gigo

# --- Карта ---
# Ключ HTTP Геокодера (developer.tech.yandex.ru): адрес заявки → точка на карте. Без него точка ставится по метро.
YANDEX_GEOCODER_KEY=
# Ключ JavaScript API Яндекс Карт для Mini App (вшивается в сборку фронтенда)
VITE_YANDEX_MAPS_KEY=

# --- Бот и Mini App ---
# Токен от @BotFather
BOT_TOKEN=
# Адрес Mini App по HTTPS, например https://gigo.example.ru
WEBAPP_URL=
# Домен для Caddy (сертификат HTTPS выпускается сам), обычно тот же, что в WEBAPP_URL, без https://
DOMAIN=
# Telegram id модераторов через запятую: им приходят жалобы на заявки, работают /ban, /unban, /stats.
# Свой id можно узнать у @userinfobot. Модератор должен хотя бы раз нажать /start в боте.
ADMIN_IDS=
# 1 = пускать в API без подписи Telegram (только для разработки в браузере и только с этой же машины)
DEV_AUTH=0
