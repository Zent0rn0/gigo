# Скопируйте в .env и заполните. Файл .env не коммитится и не пересылается в чат.

# Аккаунт-сборщик: api_id и api_hash с my.telegram.org (зайти с ОТДЕЛЬНОГО аккаунта)
TG_API_ID=
TG_API_HASH=
# Имя файла сессии в папке data/ (создаётся командой login)
TG_SESSION=collector

# База. Для локальной разработки подходит значение ниже (база из docker compose).
# На сервере задайте свой длинный POSTGRES_PASSWORD (и поменяйте его же в DATABASE_URL).
POSTGRES_PASSWORD=gigo
DATABASE_URL=postgresql://gigo:gigo@localhost:5432/gigo

# Сколько дней истории подтягивать из каждого чата при первом проходе
BACKFILL_DAYS=7
# Пауза между вступлениями в чаты, секунды (вступаем постепенно, чтобы не словить бан)
JOIN_DELAY_MIN=120
JOIN_DELAY_MAX=300
# Сколько чатов можно вступить за один запуск join
JOIN_BATCH=5

# --- Разбор объявлений ИИ ---
# claude или yandex
LLM_PROVIDER=claude
# Claude: ключ с console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# YandexGPT: API-ключ сервисного аккаунта и id каталога в Yandex Cloud
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite/latest
# Сколько сообщений разбирать параллельно
PARSER_CONCURRENCY=4

# --- Карта ---
# Ключ HTTP Геокодера (developer.tech.yandex.ru). Без него точки ставятся только по метро.
YANDEX_GEOCODER_KEY=
# Ключ JavaScript API Яндекс Карт для Mini App (вшивается в сборку фронтенда)
VITE_YANDEX_MAPS_KEY=

# --- Бот и Mini App ---
# Токен от @BotFather
BOT_TOKEN=
# Адрес Mini App по HTTPS, например https://gigo.example.ru
WEBAPP_URL=
# Домен для Caddy (сертификат HTTPS выпускается сам), обычно тот же, что в WEBAPP_URL, без https://
DOMAIN=
# 1 = пускать в API без подписи Telegram (только для разработки в браузере!)
DEV_AUTH=0
