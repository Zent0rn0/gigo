# Скопируйте в .env.local и заполните.

# Ключ JavaScript API Яндекс Карт (https://developer.tech.yandex.ru/).
# Без ключа вкладка «Карта» покажет заглушку.
VITE_YANDEX_MAPS_KEY=

# 1 — работать без бэкенда, на тестовых данных из src/mock/fixture.ts
VITE_MOCK=

# Имя бота без @ — для кнопки «Поделиться» в заявке (ссылка t.me/<бот>?startapp=job_42).
# Без него «Поделиться» копирует текст заявки без ссылки.
VITE_BOT_USERNAME=
# Короткое имя Mini App из BotFather (/newapp), если ссылка должна быть t.me/<бот>/<имя>?startapp=…
VITE_MINIAPP_NAME=
